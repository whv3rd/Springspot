---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import PageHeader from '@/components/PageHeader.astro';
import PostList from '@/components/PostList.astro';
import { getPublishedPosts } from '@/lib/blog';
import { PILLAR_LABELS, PILLARS } from '@/lib/path';
import { blogSchema, pageUrl } from '@/lib/schema';

const posts = await getPublishedPosts();
const description =
  'Operator diaries, teardowns, free playbooks and opinion on running ecommerce with AI-connected systems.';
const site = Astro.site!;
const base = import.meta.env.BASE_URL;
const schema = [
  blogSchema({
    url: pageUrl('/blog', site, base),
    name: 'The Springspot AI blog',
    description,
    siteUrl: pageUrl('/', site, base),
    posts: posts.map((post) => ({
      url: pageUrl(`/blog/${post.id}`, site, base),
      title: post.data.title,
      date: post.data.date,
      updated: post.data.updated,
    })),
  }),
];
---

<BaseLayout
  title="Blog: running ecommerce on AI-connected systems"
  description={description}
  pageType="CollectionPage"
  mainEntity={`${pageUrl('/blog', site, base)}#blog`}
  schema={schema}
  breadcrumbs={[{ name: 'Blog', path: '/blog' }]}
>
  <div class="container page">
    <PageHeader
      eyebrow="Blog"
      title="Notes from running stores on connected systems"
      lede={`${PILLARS.map((p) => PILLAR_LABELS[p]).join(', ')}. Written by an operator, from real work.`}
    />

    <section aria-labelledby="posts-title">
      <h2 id="posts-title" class="visually-hidden">
        Posts
      </h2>
      {posts.length > 0 ? (
        <PostList posts={posts} headingLevel={3} />
      ) : (
        <div class="empty">
          <p class="empty__title">No posts yet.</p>
          <p class="empty__text">
            The first posts are being written. In the meantime, see what Springspot is or read the
            free Path guide.
          </p>
          <div class="actions">
            <Button href="/what-is-springspot">What is Springspot?</Button>
            <Button href="/path" variant="secondary">
              The Path
            </Button>
          </div>
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .empty {
    max-width: var(--width-prose);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
  }

  .empty__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }

  .empty__text {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }
</style>
